{
  "problem": "String reverse",
  "statement_file": "problems/strinrev/statement.txt",
  "reference_solution": "problems/stringrev/reference.c",
  "time_limit_s": 1,
  "memory_limit_mb": 64,

  "llm": {
    "host": "http://localhost:11434",
    "model": "llama3.1",
    "temperature": 0,
    "seed": 3215
  },

  "edge_cases": {
    "empty_array":    [" "]
  },

  "metrics": [
    {
      "name": "correctness", "analyzer": "io_tests", "weight": 0.20,
      "params": { "testset_dir": "problems/stringrev/tests/" }
    },
    {
      "name": "syntax", "analyzer": "compiler_warnings", "weight": 0.10,
      "params": { "flags": "-Wall -Wextra -Werror -std=c11" }
    },
    {
      "name": "structure", "analyzer": "static_analysis", "weight": 0.10,
      "params": { "max_cyclomatic": 8, "max_function_length": 40 }
    },
    {
      "name": "modularity", "analyzer": "function_split", "weight": 0.10,
      "params": { "expect_helpers": true, "min_functions": 2 }
    },
    {
      "name": "logical", "analyzer": "edge_case_runner", "weight": 0.10,
      "params": { "cases": ["empty_array"], "llm_extra_cases": 0 }
    },
    {
      "name": "complexity", "analyzer": "complexity_estimator", "weight": 0.10,
      "params": { "required": "O(1)", "sizes": [1, 10, 100], "input_pattern": "two_ints_scaled" }
    },
    {
      "name": "memory_safety", "analyzer": "sanitizer_run", "weight": 0.10,
      "params": { "flags": "-fsanitize=address,undefined" }
    },
    {
      "name": "readability", "analyzer": "llm_review", "weight": 0.10,
      "params": { "temperature": 0, "seed": 42 }
    },
    {
      "name": "originality", "analyzer": "similarity_flag", "weight": 0.10,
      "params": { "corpus_dir": "submissions/", "flag_threshold": 0.85, "llm_baseline": true }
    }
  ]
}
